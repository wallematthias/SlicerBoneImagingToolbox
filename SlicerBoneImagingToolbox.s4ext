# Slicer extension description template for ExtensionsIndex submission.
# Copy this file into Slicer/ExtensionsIndex and keep fields in sync with this repository.

scm git
scmurl https://github.com/wallematthias/SlicerBoneImagingToolbox.git
scmrevision main

depends NA
build_subdirectory .

homepage https://github.com/wallematthias/SlicerBoneImagingToolbox
category Quantification
contributors Matthias Walle (University of Calgary)
status Experimental

iconurl https://raw.githubusercontent.com/wallematthias/SlicerBoneImagingToolbox/main/resources/icon.png
